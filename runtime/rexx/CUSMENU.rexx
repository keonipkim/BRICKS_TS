/* CUSMENU.rexx - Customer / contacts submenu. QUERY SECURITY. */
EXEC CICS ASSIGN USERID(UID) DATE(TODAY) TIME(NOWTIME) END-EXEC
DISPDATE = SUBSTR(TODAY,5,2)'/'SUBSTR(TODAY,7,2)'/'SUBSTR(TODAY,1,4)
DISPTIME = SUBSTR(NOWTIME,1,2)':'SUBSTR(NOWTIME,3,2)':'SUBSTR(NOWTIME,5,2)

ROLESTR = 'ACCESS: PUBLIC'
IF STRIP(UID) \= '' THEN DO
  /* ALTERABLE (52) = caller is in ADMIN. 3.5.6 READ is no longer an admin proxy. */
  EXEC CICS QUERY SECURITY RESTYPE('TRANSATTACH') RESID('SQLM') ALTER(RSQL) LOGMESSAGE(NOLOG) END-EXEC
  IF EIBRESP = 0 & RSQL = 52 THEN ROLESTR = 'ACCESS: ADMIN'
  ELSE ROLESTR = 'ACCESS: USER'
END
OUT.DATFLD = DISPDATE; OUT.TIMFLD = DISPTIME
OUT.USRFLD = STRIP(UID); OUT.ROLEFLD = ROLESTR

N = 0
N = N+1; TXID.N = 'CUST'; TXDESC.N = 'CUSTOMER MAINT (REXX)'
N = N+1; TXID.N = 'GUST'; TXDESC.N = 'CUSTOMER MAINT (COBOL)'
N = N+1; TXID.N = 'PERS'; TXDESC.N = 'CONTACTS (COBOL)'
TOTALMASTER = N

VISCOUNT = 0
DO I = 1 TO TOTALMASTER
  OK = 36
  RID = TXID.I
  EXEC CICS QUERY SECURITY RESTYPE('TRANSATTACH') RESID(RID) READ(OK) LOGMESSAGE(NOLOG) END-EXEC
  IF EIBRESP = 0 & OK = 35 THEN DO
    VISCOUNT = VISCOUNT + 1
    VISID.VISCOUNT = TXID.I
    VISDESC.VISCOUNT = TXDESC.I
  END
END

PAGESIZE = 8
DO SLOT = 1 TO PAGESIZE
  NUM = RIGHT(SLOT,2,'0')
  INTERPRET "OUT.L"||NUM" = ''"
END
SLOT = 0
IF VISCOUNT = 0 THEN DO
  OUT.L01 = '(NO AUTHORIZED ITEMS)'
END
ELSE DO V = 1 TO VISCOUNT
  SLOT = SLOT + 1
  NUM = RIGHT(V,2,'0')
  INTERPRET "OUT.L"||NUM" = LEFT(NUM'.  'VISID.V'  'VISDESC.V, 38)"
END
OUT.FOOTFLD = 'PF3=MAIN  PF9=HELP   ENTER=SELECT'

EXEC CICS SEND MAP('CUSMENU') MAPSET('CUSMENU') FROM(OUT.) ERASE END-EXEC
EXEC CICS RECEIVE MAP('CUSMENU') MAPSET('CUSMENU') INTO(IN.) END-EXEC

AID = C2X(EIBAID)
IF AID = 'F1' | AID = 'F3' THEN EXEC CICS RETURN TRANSID('MYMU') END-EXEC
IF AID = 'F9' THEN DO
  CA = 'CUSM'
  EXEC CICS XCTL PROGRAM('MHLP') COMMAREA(CA) END-EXEC
END

SEL = STRIP(IN.SELFLD)
IF DATATYPE(SEL,'N') THEN DO
  SELNUM = SEL + 0
  IF SELNUM >= 1 & SELNUM <= SLOT THEN DO
    DEST = VISID.SELNUM
    EXEC CICS XCTL PROGRAM(DEST) END-EXEC
  END
END
EXEC CICS RETURN TRANSID('CUSM') END-EXEC
