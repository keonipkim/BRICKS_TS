/* ABZP - ZERODIVIDE demo (PL/I): COUNT is 0 when AVERAGE divides.  */
ABZP: PROC OPTIONS(MAIN);
   DCL TOTAL  FIXED DEC(7,2) INIT(250);
   DCL COUNT  FIXED BIN(31)  INIT(0);
   DCL AVG    FIXED DEC(7,2) INIT(0);
   CALL AVERAGE;
   EXEC CICS RETURN;
AVERAGE: PROC;
   DCL I FIXED BIN(15) INIT(3);
   AVG = TOTAL / COUNT;
END AVERAGE;
END ABZP;
