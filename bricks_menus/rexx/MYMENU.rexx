/* MYMENU.rexx - Main category menu, role-aware */
EXEC CICS ASSIGN USERID(UID) END-EXEC
EXEC CICS ASSIGN DATE(TODAY) TIME(NOWTIME) END-EXEC
DISPDATE = SUBSTR(TODAY,5,2)'/'SUBSTR(TODAY,7,2)'/'SUBSTR(TODAY,1,4)
DISPTIME = SUBSTR(NOWTIME,1,2)':'SUBSTR(NOWTIME,3,2)':'SUBSTR(NOWTIME,5,2)

/* Read groups from users.conf */
USERGROUPS = 'PUBLIC'
USERSCONF = 'runtime/users.conf'
DO WHILE LINES(USERSCONF) > 0
  RL = LINEIN(USERSCONF)
  IF LEFT(RL,1)='#' | RL='' THEN ITERATE
  PARSE VAR RL CU ':' CH ':' CG
  IF TRANSLATE(STRIP(CU))=TRANSLATE(STRIP(UID)) THEN DO
    USERGROUPS=TRANSLATE(STRIP(CG)); LEAVE
  END
END
CALL LINEOUT USERSCONF
ISADMIN = (POS('ADMIN',USERGROUPS)>0)
ISUSERS = (POS('USERS',USERGROUPS)>0)|ISADMIN
IF ISADMIN THEN ROLESTR='ACCESS: ADMIN'
ELSE IF ISUSERS THEN ROLESTR='ACCESS: USERS'
ELSE ROLESTR='ACCESS: PUBLIC'

OUT.DATFLD=DISPDATE; OUT.TIMFLD=DISPTIME
OUT.USRFLD=STRIP(UID); OUT.ROLEFLD=ROLESTR

/* Build visible category list based on role */
N=0
N=N+1; CATID.N='REXM'; CATDESC.N='REXX PROGRAMS';       CATGRP.N='public'
N=N+1; CATID.N='COBM'; CATDESC.N='COBOL PROGRAMS';      CATGRP.N='public'
N=N+1; CATID.N='CUSM'; CATDESC.N='CUSTOMER MANAGEMENT'; CATGRP.N='users'
N=N+1; CATID.N='QUEM'; CATDESC.N='QUEUE AND STORAGE';   CATGRP.N='users'
N=N+1; CATID.N='SQLM'; CATDESC.N='SQL / DATABASE';      CATGRP.N='admin'
N=N+1; CATID.N='SYSM'; CATDESC.N='SYSTEM AND ADMIN';    CATGRP.N='admin'
N=N+1; CATID.N='LOFF'; CATDESC.N='LOGOFF';              CATGRP.N='public'
TOTALCAT=N

VISCOUNT=0
DO I=1 TO TOTALCAT
  ALLOWED=0
  IF CATGRP.I='public' THEN ALLOWED=1
  IF CATGRP.I='users' & ISUSERS THEN ALLOWED=1
  IF CATGRP.I='admin' & ISADMIN THEN ALLOWED=1
  IF ALLOWED THEN DO
    VISCOUNT=VISCOUNT+1
    VISID.VISCOUNT=CATID.I
    VISDESC.VISCOUNT=CATDESC.I
  END
END

DO V=1 TO VISCOUNT
  NUM=RIGHT(V,2,'0')
  INTERPRET "OUT.L"||NUM" = LEFT(NUM'.  'VISDESC.V, 38)"
END

EXEC CICS SEND MAP('MYMENU') MAPSET('MYMENU') FROM(OUT.) ERASE END-EXEC
EXEC CICS RECEIVE MAP('MYMENU') MAPSET('MYMENU') INTO(IN.) END-EXEC

IF EIBAID=DFHPF1 THEN EXEC CICS XCTL PROGRAM('CSSF') END-EXEC
IF EIBAID=DFHPF9 THEN DO
  EXEC CICS XCTL PROGRAM('MYHELP') COMMAREA('MYMU') END-EXEC
END

SEL=STRIP(IN.SELFLD)
IF DATATYPE(SEL,'N') THEN DO
  SELNUM=SEL+0
  IF SELNUM>=1 & SELNUM<=VISCOUNT THEN DO
    IF VISID.SELNUM='LOFF' THEN EXEC CICS XCTL PROGRAM('CSSF') END-EXEC
    EXEC CICS XCTL PROGRAM(VISID.SELNUM) END-EXEC
  END
END
EXEC CICS RETURN TRANSID('MYMU') END-EXEC
